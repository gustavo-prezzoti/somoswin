# WIN.AI Frontend - Configurações de Ambiente (Exemplo)
# Copie este arquivo para .env e ajuste os valores conforme necessário

# URL da API Backend
# =====================================================
# Desenvolvimento local:
VITE_API_URL=http://localhost:8080/api/v1

# Produção:
# VITE_API_URL=https://server.somoswin.com.br/api/v1

# =====================================================
# Backend (Java) — SMTP para convites (não é variável VITE; configure no processo do servidor ou .env raiz somoswin/.env)
# MAIL_HOST= smtp...
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=noreply@suaempresa.com.br
# APP_FRONTEND_URL=https://seu-front.com
# =====================================================
# NOTA: O WebSocket é derivado automaticamente da URL da API
# (remove /api/v1 e adiciona /ws)
# Por exemplo:
#   API: http://localhost:8080/api/v1
#   WS:  ws://localhost:8080/ws
# =====================================================
